# LLM Provider Configuration
# Choose: "cloud" or "ollama"
LLM_PROVIDER=cloud

# Cloud LLM Settings (Google Gemini or OpenAI)
CLOUD_MODEL=gemini-3.6-flash
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: If using OpenAI instead
# OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama Settings (100% Offline / Free)
OLLAMA_MODEL=mistral:latest
OLLAMA_BASE_URL=http://localhost:11434/v1

# Escalation Threshold (Cosine Similarity 0.0 - 1.0)
ESCALATION_THRESHOLD=0.55
